{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 20,
      "includeFiles": "api/vendor/**",
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/movie/:path*", "destination": "/index.html" },
    { "source": "/tv/:path*", "destination": "/index.html" },
    { "source": "/watch/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
